/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-XSS-Protection: 0

  # CSP notes:
  # - script-src: Cloudflare Insights (remove if not using)
  # - connect-src: 'self', Cloudflare Insights, and the family member
  #   origins. The /status page's family-status island fetches each
  #   sibling's served /status.json cross-origin at load; without these
  #   connect-src entries the browser refuses the fetch before any CORS
  #   runs, and the family grid degrades to "Failed to fetch" instead of
  #   the honest per-row absence. Keep the list in sync with the island's
  #   member list (web/src/components/FamilyStatusIsland.jsx).
  # - style-src / font-src: includes Google Fonts (remove if not using)
  # - Tighten or expand each directive to match your actual asset sources.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://eyestruct.creadev.org https://crashtest.creadev.org https://poststruct.creadev.org https://packstruct.creadev.org https://govstruct.creadev.org https://monoforge.creadev.org; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

# The family-status@1 file (docs/status.md): read back by every sibling
# member's island, which are OTHER origins, so ACAO is part of the reader
# half of the contract. It is regenerated every build and never committed
# (regeneration is the freshness), so no-cache and a plain star are the
# honest shape. ACAO rides the miss path too, so a not-yet member reads as
# an honest HTTP 404 at the reader, never an opaque network failure.
/status.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
